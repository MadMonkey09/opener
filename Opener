
(function(){
    'use strict';

    if(window.__rightSideOpenerLoaded) return;
    window.__rightSideOpenerLoaded = true;

    let resultMap = {};
    let isOpening = false;

    // Font
    const fontLink = document.createElement('link');
    fontLink.rel = 'stylesheet';
    fontLink.href = 'https://fonts.googleapis.com/css2?family=Orbitron:wght@500&display=swap';
    document.head.appendChild(fontLink);
    const font = `'Orbitron', sans-serif`;

    // Right panel
    const panel = document.createElement('div');
    Object.assign(panel.style,{
        position:'fixed', top:'50px', right:'20px', width:'220px', height:'400px',
        background:'rgba(10,10,30,0.9)', border:'2px solid #33ffff', borderRadius:'12px',
        display:'flex', flexDirection:'column', alignItems:'center', padding:'10px', gap:'6px',
        boxShadow:'0 0 15px #33ffff', zIndex:3000, fontFamily:font
    });
    document.body.appendChild(panel);

    // Token bar
    const tokenBar = document.createElement('div');
    tokenBar.textContent=`Tokens: ${blacket.user.tokens}`;
    Object.assign(tokenBar.style,{color:'#33ffff', fontWeight:'700', fontSize:'0.9rem'});
    panel.appendChild(tokenBar);

    // Pack selector
    const packSelect = document.createElement('select');
    Object.keys(blacket.packs).forEach(p=>{
        const opt = document.createElement('option'); opt.value=p; opt.textContent=p; packSelect.appendChild(opt);
    });
    Object.assign(packSelect.style,{
        width:'90%', padding:'6px', borderRadius:'8px', border:'2px solid #33ffff', background:'rgba(0,0,0,0.2)', color:'#33ffff'
    });
    panel.appendChild(packSelect);

    // Amount input
    const countInput = document.createElement('input');
    countInput.type='number'; countInput.min=1; countInput.value=1;
    Object.assign(countInput.style,{
        width:'50%', padding:'4px', borderRadius:'8px', border:'2px solid #33ffff', background:'rgba(0,0,0,0.2)', color:'#33ffff', textAlign:'center'
    });
    panel.appendChild(countInput);

    // Open button
    const openBtn = document.createElement('button');
    openBtn.textContent='▶';
    Object.assign(openBtn.style,{
        marginTop:'auto', width:'40px', height:'40px', borderRadius:'50%', border:'2px solid #33ffff',
        background:'rgba(0,0,0,0.3)', color:'#33ffff', cursor:'pointer', fontWeight:'700',
        fontSize:'1.2rem', display:'flex', alignItems:'center', justifyContent:'center', boxShadow:'0 0 10px #33ffff'
    });
    openBtn.onmouseenter=()=>openBtn.style.boxShadow='0 0 20px #33ffff';
    openBtn.onmouseleave=()=>openBtn.style.boxShadow='0 0 10px #33ffff';
    panel.appendChild(openBtn);

    // Blook stack (vertical scroll)
    const blookStack = document.createElement('div');
    Object.assign(blookStack.style,{
        marginTop:'6px', flexGrow:1, width:'100%', display:'flex', flexDirection:'column-reverse',
        overflowY:'auto', gap:'4px'
    });
    panel.appendChild(blookStack);

    // Append blook card
    function addBlook(name){
        const info = blacket.blooks[name] || {};
        const rarity = info.rarity || 'Common';
        const color = blacket.rarities[rarity]?.color || '#33ffff';
        const img = info.image || '/content/blooks/Error.webp';

        if(!resultMap[name]){
            const card = document.createElement('div');
            Object.assign(card.style,{
                width:'90%', height:'40px', border:`2px solid ${color}`, borderRadius:'6px',
                display:'flex', alignItems:'center', gap:'6px', background:'rgba(0,0,0,0.25)',
                opacity:0, transform:'translateX(40px)', transition:'0.3s'
            });
            card.innerHTML=`<img src="${img}" style="width:32px;height:32px;border-radius:4px;box-shadow:0 0 6px ${color}"> <span style="color:${color}; font-weight:700;">${name}</span>`;
            resultMap[name]={count:1, element:card};
            blookStack.appendChild(card);
            requestAnimationFrame(()=>{ card.style.opacity=1; card.style.transform='translateX(0)'; });
        } else {
            resultMap[name].count++;
            const span = resultMap[name].element.querySelector('span');
            span.textContent=`${name} (${resultMap[name].count})`;
            resultMap[name].element.animate([
                {boxShadow:`0 0 6px ${color}`},
                {boxShadow:`0 0 14px ${color}`}
            ],{duration:200, iterations:1});
        }
        blookStack.scrollTop=blookStack.scrollHeight;
    }

    async function openPack(pack){
        return new Promise(resolve=>{
            blacket.requests.post('/worker3/open',{pack},data=>{
                if(data.error) return resolve(null);
                blacket.user.tokens -= blacket.packs[pack].price;
                tokenBar.textContent=`Tokens: ${blacket.user.tokens}`;
                blacket.user.blooks[data.blook]=(blacket.user.blooks[data.blook]||0)+1;
                resolve(data.blook);
            });
        });
    }

    async function openSequential(pack,count){
        if(isOpening) return;
        isOpening=true;
        resultMap={};
        blookStack.innerHTML='';
        let opened=0;
        while(opened<count){
            const blook = await openPack(pack);
            if(!blook){ await new Promise(r=>setTimeout(r,50)); continue; }
            addBlook(blook);
            opened++;
            const rarity = blacket.blooks[blook]?.rarity || 'Common';
            const wait = blacket.rarities[rarity]?.wait || 50;
            await new Promise(r=>setTimeout(r,Math.max(7,wait)));
        }
        isOpening=false;
    }

    openBtn.onclick=()=>{
        const pack=packSelect.value;
        const amt=parseInt(countInput.value);
        const max=Math.floor(blacket.user.tokens/blacket.packs[pack].price);
        if(!pack||amt<1||amt>max){ alert(`Invalid input (Max: ${max})`); return; }
        openSequential(pack,amt);
    };

})();
